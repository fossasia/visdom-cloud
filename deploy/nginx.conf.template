# Production reverse-proxy config. Rendered by the nginx image's envsubst at
# startup (this file lives in /etc/nginx/templates/), so ${...} values below come
# from the environment (the compose .env) — nothing here is hardcoded. nginx's own
# runtime variables ($host, $http_upgrade, $ws_slug, ...) are not in the env, so
# envsubst leaves them untouched.
#
# This block is included inside the base image's http{}.

proxy_cache_path /var/cache/nginx/auth levels=1:2 keys_zone=auth_cache:1m
                 max_size=10m inactive=60s use_temp_path=off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types
    application/javascript
    application/json
    application/wasm
    application/xml
    image/svg+xml
    text/css
    text/javascript
    text/plain;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Shard key: the workspace a request belongs to. visdom keeps live state (envs +
# socket subscribers) in memory per workspace, so every request touching a
# workspace — writes, reads, and the websocket — must reach the same instance.
# Sticky-by-session is NOT enough: one workspace has many sessions.
#
# Read off $request_uri rather than the $ws_slug capture below, so the key does
# not depend on which location matched or on when captures are set relative to
# upstream selection.
map $request_uri $shard_key_path {
    default                       "";
    "~^/vis/w/(?<uri_slug>[^/]+)/" $uri_slug;
}

# Browser traffic carries the slug in the path; the python client sends it as a
# header instead. Either way the same workspace yields the same key.
map $shard_key_path $shard_key {
    default $shard_key_path;
    ""      $http_x_visdom_workspace;
}

upstream console_gateway {
    server ${GATEWAY_HOST}:${GATEWAY_PORT};
}

# One visdom process saturates one core (~575 line writes/s, measured — see
# bench/README.md), so capacity comes from more instances, not a bigger box.
# `consistent` means adding or removing an instance migrates only ~1/N of
# workspaces instead of reshuffling all of them.
#
# Requests with no workspace at all (SPA assets, /vis/ without a header) hash on
# the empty key, which is deterministic — they all land on one instance. Harmless,
# since those responses are identical everywhere, but it does make that instance
# look busier than its peers.
upstream visdom_server {
    hash $shard_key consistent;
    ${VISDOM_SERVERS}
}

server {
    listen ${NGINX_PORT};
    server_name _;

    # Keep redirects relative so the browser preserves the external scheme/port
    # (this proxy listens on an internal port that differs from the public one).
    absolute_redirect off;

    include /etc/nginx/security-headers.conf;

    # Built console SPA, served directly by nginx.
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
        access_log off;
    }

    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    location /api/v1/ {
        proxy_pass http://console_gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Coarse auth gate: valid session cookie OR valid API key.
    location = /_auth_verify {
        internal;
        proxy_pass http://console_gateway/api/v1/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-API-KEY $http_x_api_key;

        # Keyed on the credential alone; the gate reads nothing else.
        proxy_cache auth_cache;
        proxy_cache_key "$cookie_session_token|$http_x_api_key";
        proxy_cache_valid 200 30s;
        proxy_cache_valid 401 403 5s;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_hide_header Set-Cookie;
    }

    # Browser read path: /vis/w/<slug>/... — inject the workspace from the URL.
    location ~ ^/vis/w/(?<ws_slug>[^/]+)/(?<vis_rest>.*)$ {
        auth_request /_auth_verify;
        error_page 401 = @auth_redirect;

        rewrite ^/vis/w/[^/]+/(.*)$ /vis/$1 break;
        proxy_pass http://visdom_server;
        proxy_http_version 1.1;
        proxy_set_header X-Visdom-Workspace $ws_slug;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
        add_header X-Visdom-Upstream $upstream_addr always;
        include /etc/nginx/security-headers.conf;
    }

    # Write path (python client, X-API-KEY + X-Visdom-Workspace headers) and any
    # other visdom traffic.
    location /vis/ {
        auth_request /_auth_verify;
        error_page 401 = @auth_redirect;

        proxy_pass http://visdom_server;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Which instance served this, so bench/shardcheck.py can prove a workspace
        # pins to one shard. add_header at this level replaces the ones inherited
        # from server{}, so the security headers have to be re-included here.
        add_header X-Visdom-Upstream $upstream_addr always;
        include /etc/nginx/security-headers.conf;
    }

    location @auth_redirect {
        default_type application/json;
        if ($http_x_api_key) {
            return 401 '{"detail":"Invalid or expired API key"}';
        }
        return 302 /login?next=$request_uri;
    }
}
